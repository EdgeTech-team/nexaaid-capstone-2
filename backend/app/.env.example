# backend/app/.env.example
# Copy to backend/app/.env and fill in. Only the settings added for Dave's
# donor-side security tasks (Nov 18 brief) are listed here; the existing
# settings (DATABASE_URL, SECRET_KEY, mail, pickup rules ...) stay as they are
# in your own .env. Every value below is optional: the default is used when
# it is missing or not a positive whole number.

# ---------------------------------------------------------------------------
# NF-005 (D2): limits on guest donations (anti-flooding). Logged-in donors
# are never affected.
# ---------------------------------------------------------------------------
# Pending guest entries one phone number may have at a time (counted in the
# database). The next one is refused with 429 "You already have 2 donations
# waiting. Bring them to CSWS first, or sign in."
GUEST_MAX_OPEN_ENTRIES=2

# NF-004: may guests (no account) choose Door to Door?
#   blocked  (default) Drop Off only; the app shows Door to Door locked with
#            "Register (takes 2 minutes)" and keeps the donation through sign-in
#   limited  guests may ask for Door to Door, GUEST_MAX_OPEN_PICKUPS at a time
# Anything else counts as blocked. Switch without a code change or new app.
GUEST_DOOR_TO_DOOR=blocked

# Only with GUEST_DOOR_TO_DOOR=limited: Door to Door pickups one guest
# number may have waiting at a time. Every
# pickup sends staff and a vehicle to an address nobody has checked, so for
# NexaAid security and the pickup team's safety a guest gets one; a
# registered account can request more.
GUEST_MAX_OPEN_PICKUPS=1

# Guest submissions per hour from one connection (client address). Counted in
# server memory like the failed-login counter, so a restart resets it. The
# address is read from X-Forwarded-For behind Render's proxy
# (core/client_ip.py, TRUSTED_PROXY_HOPS).
GUEST_MAX_PER_IP_HOUR=5

# Largest quantity a guest may pledge on one item line, in the item's base
# unit (kg, L, pcs ...). Above it: 422 "For large donations please sign in."
GUEST_MAX_LINE_QTY=100

# ---------------------------------------------------------------------------
# NF-006 (D4): a Door to Door donation from an account whose email is not
# verified yet expires after this many hours (close_reason
# "Email not verified").
# ---------------------------------------------------------------------------
EMAIL_VERIFY_HOLD_HOURS=48

# ---------------------------------------------------------------------------
# D7: drop-off card wording. The office name the app shows on the drop-off
# card and the receipt (manuscript: CSWS Main Office).
# ---------------------------------------------------------------------------
DROPOFF_NAME=CSWS Main Office
